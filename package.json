{
  "name": "giteffects",
  "displayName": "GitEffects",
  "description": "Plays sound effects for git events (commit, push, merge conflict, terminal failure)",
  "version": "0.1.0",
  "publisher": "giteffects",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitEffects",
      "properties": {
        "giteffects.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitEffects sound playback"
        },
        "giteffects.volume": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Playback volume (0.0 to 1.0)"
        },
        "giteffects.soundsPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to sound files directory. Leave empty to use bundled sounds."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "play-sound": "^1.1.6"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "MIT"
}
