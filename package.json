{
  "name": "giteffects",
  "displayName": "GitEffects",
  "description": "Plays sound effects for git and terminal events",
  "version": "0.1.0",
  "publisher": "giteffects",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitEffects",
      "properties": {
        "giteffects.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitEffects sound playback"
        },
        "giteffects.volume": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Playback volume (0.0 to 1.0)"
        },
        "giteffects.soundsPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to sound files directory. Leave empty to use bundled sounds."
        }
      }
    },
    "commands": [
      {
        "command": "giteffects.toggle",
        "title": "GitEffects: Toggle On/Off"
      },
      {
        "command": "giteffects.testSound",
        "title": "GitEffects: Play a Test Sound"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npm run compile && vsce package",
    "test": "node out/test-classify.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheHotGuy69/giteffects.git"
  },
  "license": "MIT"
}
